<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.SmapiVersionPickerDialog">
	<Border Classes="hintCard">
		<StackPanel Spacing="8">
			<TextBlock Text="选择 SMAPI 版本" Classes="hintTitle" />
			<TextBlock Text="可选择推荐稳定版或手动输入版本号。" TextWrapping="Wrap" />

			<ComboBox SelectedIndex="0">
				<ComboBoxItem Content="推荐稳定版（Latest）" />
				<ComboBoxItem Content="预览版（Preview）" />
				<ComboBoxItem Content="历史版本" />
			</ComboBox>

			<TextBox Watermark="可选：输入指定版本，例如 4.1.10" />

			<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
				<Button Content="取消" />
				<Button Content="确认" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
