<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.FloatingNotificationControl"
						 x:Name="Root">
	<Border Classes="panel" Padding="10" CornerRadius="10">
		<Grid ColumnDefinitions="Auto,*,Auto">
			<Border Grid.Column="0" Classes="hintCard" Padding="6,1">
				<TextBlock Text="{Binding LevelText, ElementName=Root}" />
			</Border>
			<TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{Binding Message, ElementName=Root}" TextWrapping="Wrap" />
			<Button Grid.Column="2" Content="关闭" Command="{Binding DismissCommand, ElementName=Root}" />
		</Grid>
	</Border>
</UserControl>
