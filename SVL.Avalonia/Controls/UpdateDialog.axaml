<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SVL.Avalonia.Controls.UpdateDialog"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="启动器更新">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Text="发现新版本" FontSize="20" FontWeight="SemiBold" />

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,8">
        <TextBlock Text="版本" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" x:Name="VersionText" Text="-" />
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,10">
        <TextBlock Text="来源" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" x:Name="SourceText" Text="-" Margin="8,0,0,0" />
        <TextBlock Grid.Column="2" Text="发布时间" FontWeight="SemiBold" Margin="20,0,0,0" />
        <TextBlock Grid.Column="3" x:Name="PublishedAtText" Text="-" Margin="8,0,0,0" />
      </Grid>

      <Border Grid.Row="3" Classes="hintCard" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="更新日志" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBox Grid.Row="1"
                   x:Name="ChangelogText"
                   Text="暂无更新日志"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="220" />
        </Grid>
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
        <TextBlock Text="可选择忽略此版本，或跳转到发布页下载更新包。" Opacity="0.75" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="忽略此版本" Click="SkipVersion_Click" Margin="8,0,0,0" />
        <Button Grid.Column="2" Content="稍后" Click="Later_Click" Margin="8,0,0,0" />
        <Button Grid.Column="3" Content="打开下载页" Click="OpenRelease_Click" Margin="8,0,0,0" />
      </Grid>
    </Grid>
  </Border>
</Window>
