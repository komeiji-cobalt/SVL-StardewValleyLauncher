<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SVL.Avalonia.ViewModels"
             x:Class="SVL.Avalonia.Views.ModDetailsPageView"
             x:DataType="vm:ModDetailsPageViewModel">
  <Border Classes="panel">
    <ScrollViewer>
      <StackPanel Spacing="12">
        <Border Classes="hintCard">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="{Binding DisplayResourceName}" Classes="heroTitle" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" ItemHeight="24">
                <TextBlock Text="{Binding ResourceSource}" Classes="pill" />
                <TextBlock Text="{Binding ResourceMetricTag}" Classes="pill" IsVisible="{Binding HasResourceMetricTag}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding ResourceTimeTag}" Classes="pill" IsVisible="{Binding HasResourceTimeTag}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding ResourceIdText, StringFormat=资源ID: {0}}" Classes="pill" Margin="6,0,0,0" />
              </WrapPanel>
              <TextBlock Text="{Binding DisplayResourceSummary}" TextWrapping="Wrap" Opacity="0.8" />
              <TextBlock Text="{Binding DetailsStatus, StringFormat=状态: {0}}" Opacity="0.75" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0" HorizontalAlignment="Right">
              <Button Content="转到来源"
                      Command="{Binding OpenSourcePageCommand}"
                      IsEnabled="{Binding HasSourcePageUrl}"
                      MinWidth="92" />

              <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding HasLocalizedResourceName}">
                <TextBlock Grid.Column="0" Text="名称" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="中" Command="{Binding ShowLocalizedNameCommand}" MinWidth="42" Margin="0,0,6,0" />
                <Button Grid.Column="2" Content="EN" Command="{Binding ShowSourceNameCommand}" MinWidth="42" />
              </Grid>

              <Grid ColumnDefinitions="Auto,Auto,Auto" IsVisible="{Binding HasLocalizedResourceSummary}">
                <TextBlock Grid.Column="0" Text="描述" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="中" Command="{Binding ShowLocalizedSummaryCommand}" MinWidth="42" Margin="0,0,6,0" />
                <Button Grid.Column="2" Content="EN" Command="{Binding ShowSourceSummaryCommand}" MinWidth="42" />
              </Grid>

              <Border Classes="hintCard" Padding="8">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0" Text="复制" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,6,0" />
                  <Button Grid.Column="1" Content="名称" Command="{Binding CopyNameCommand}" MinWidth="56" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="2" Text="|" VerticalAlignment="Center" Opacity="0.45" Margin="0,0,6,0" />
                  <Button Grid.Column="3" Content="{Binding CopyIdButtonText}" Command="{Binding CopyIdCommand}" MinWidth="50" Margin="0,0,6,0" />
                </Grid>
              </Border>

              <Border Classes="hintCard" Padding="8">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Grid.Column="0" Content="贡献本地化" Command="{Binding OpenLocalizationContributionPageCommand}" />
                  <Button Grid.Column="1" Content="i" Command="{Binding ShowLocalizationContributorInfoCommand}" Width="30" Margin="8,0,0,0" />
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="hintCard">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding DownloadSectionTitle}" Classes="hintTitle" />
            <ComboBox ItemsSource="{Binding DownloadOptions}" SelectedItem="{Binding SelectedDownloadOption}" IsEnabled="{Binding HasDownloadOptions}" />
                <WrapPanel Orientation="Horizontal" ItemHeight="34" ItemWidth="126">
                  <Button Content="安装到实例"
                    Command="{Binding InstallSelectedDownloadOptionCommand}"
                    IsEnabled="{Binding CanInstallSelectedDownloadOption}"
                    HorizontalAlignment="Left" />
                  <Button Content="另存为"
                    Command="{Binding SaveSelectedDownloadOptionAsCommand}"
                    IsEnabled="{Binding CanSaveSelectedDownloadOptionAs}"
                    HorizontalAlignment="Left" />
              <Button Content="打开所选链接"
                      Command="{Binding OpenSelectedDownloadOptionInBrowserCommand}"
                      IsEnabled="{Binding CanOpenSelectedDownloadOptionInBrowser}"
                      HorizontalAlignment="Left" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="hintCard">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding VersionSectionTitle}" Classes="hintTitle" />
            <TextBlock Text="{Binding VersionGroupHintText}" Opacity="0.7" IsVisible="{Binding HasVersionGroups}" />
            <TextBlock Text="暂无版本信息" Opacity="0.65" IsVisible="{Binding HasNoVersionGroups}" />
            <ScrollViewer Height="220" IsVisible="{Binding HasVersionGroups}">
              <ItemsControl ItemsSource="{Binding VersionGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="hintCard" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                          <TextBlock Grid.Column="0" Text="{Binding GroupTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Background="#223B82F6" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding SourceTag}" Foreground="#FF1D4ED8" FontSize="11" FontWeight="SemiBold" />
                          </Border>
                          <Border Grid.Column="2" Background="#1A16A34A" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CountText, StringFormat=共 {0} 条}" Foreground="#FF166534" FontSize="11" FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border Classes="hintCard">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding DependencySectionTitle}" Classes="hintTitle" />
            <TextBlock Text="暂无依赖信息" Opacity="0.65" IsVisible="{Binding HasNoDependencyItems}" />
            <StackPanel Spacing="8" IsVisible="{Binding HasDependencyItems}">
              <StackPanel Spacing="4" IsVisible="{Binding HasRequiredDependencyItems}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,2">
                  <TextBlock Grid.Column="0" Text="{Binding RequiredDependencyHeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#1A16A34A" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RequiredDependencyCountText, StringFormat=数量 {0}}" Foreground="#FF166534" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Border Grid.Column="2" Background="#1F22C55E" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="必需" Foreground="#FF15803D" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                    <Button Grid.Column="3"
                          Content="{Binding RequiredDependencyToggleText}"
                          Command="{Binding ToggleRequiredDependenciesExpandedCommand}"
                          MinWidth="58"
                          Height="28"
                          Margin="10,0,0,0" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RequiredDependencyItems}" IsVisible="{Binding ShowRequiredDependencyList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding}" TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="来源页"
                                Command="{Binding DataContext.OpenDependencySourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                MinWidth="62"
                                Height="26"
                                Margin="10,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasHardConflictDependencyItems}">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,2">
                  <TextBlock Grid.Column="0" Text="硬冲突" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#1AF97316" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HardConflictDependencyCountText, StringFormat=数量 {0}}" Foreground="#FFC2410C" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Border Grid.Column="2" Background="#1FDC2626" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="冲突" Foreground="#FFB91C1C" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding HardConflictDependencyItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding}" TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="来源页"
                                Command="{Binding DataContext.OpenDependencySourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                MinWidth="62"
                                Height="26"
                                Margin="10,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasFunctionalOverlapDependencyItems}">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,2">
                  <TextBlock Grid.Column="0" Text="功能重叠" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="#1AF59E0B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FunctionalOverlapDependencyCountText, StringFormat=数量 {0}}" Foreground="#FFB45309" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Border Grid.Column="2" Background="#1FD97706" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="重叠" Foreground="#FF9A3412" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding FunctionalOverlapDependencyItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="{Binding}" TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Content="来源页"
                                Command="{Binding DataContext.OpenDependencySourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                MinWidth="62"
                                Height="26"
                                Margin="10,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="hintCard" IsVisible="{Binding HasDownloadOptions}">
          <StackPanel Spacing="8">
            <TextBlock Text="可下载条目" Classes="hintTitle" />
            <ScrollViewer Height="150">
              <ItemsControl ItemsSource="{Binding DownloadOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
