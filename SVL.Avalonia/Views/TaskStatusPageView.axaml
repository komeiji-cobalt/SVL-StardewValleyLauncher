<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SVL.Avalonia.ViewModels"
             x:Class="SVL.Avalonia.Views.TaskStatusPageView"
             x:DataType="vm:TaskStatusPageViewModel">
  <Grid ColumnDefinitions="280,*">
    <Border Grid.Column="0" Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="任务总览" Classes="sectionTitle" />

        <Border Classes="hintCard" IsVisible="{Binding IsEmptyState}">
          <StackPanel Spacing="6">
            <TextBlock Text="📭" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="当前没有任务" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="去下载页发起任务后，这里会实时显示进度与失败重试入口。" Opacity="0.72" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Content="前往下载"
                Command="{Binding GoToDownloadCommand}"
                IsVisible="{Binding IsEmptyState}"
                HorizontalAlignment="Center"
                MinWidth="120"
                Height="34" />

        <Border Classes="hintCard" IsVisible="{Binding ShowMainStateContent}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding CurrentTaskName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentTaskStatus}" Opacity="0.8" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="hintCard" IsVisible="{Binding ShowMainStateContent}">
          <StackPanel Spacing="4">
            <TextBlock Text="任务统计" Classes="hintTitle" />
            <TextBlock Text="{Binding ActiveTasksCount, StringFormat=进行中: {0}}" />
            <TextBlock Text="{Binding FinishedTasksCount, StringFormat=历史: {0}}" />
            <TextBlock Text="{Binding SelectedTaskHint}" Opacity="0.72" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="hintCard" IsVisible="{Binding ShowMainStateContent}">
          <StackPanel Spacing="8">
            <TextBlock Text="快速操作" Classes="hintTitle" />
            <Button Content="一键重试失败项"
                    Classes="settingsNav"
                    Command="{Binding RetryFailedItemsCommand}"
                    IsEnabled="{Binding CanRetryFailedItems}"
                    HorizontalAlignment="Stretch" />
            <Button Content="打开最新重试报告"
                    Classes="settingsNav"
                    Command="{Binding OpenLatestRetryReportCommand}"
                    IsEnabled="{Binding HasLatestRetryReport}"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>

        <Border Classes="hintCard" IsVisible="{Binding HasRetryReportHistory}">
          <StackPanel Spacing="6">
            <TextBlock Text="重试报告历史" Classes="hintTitle" />
            <ScrollViewer Height="180">
              <ItemsControl ItemsSource="{Binding RetryReportHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}"
                            Command="{Binding DataContext.OpenRetryReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            HorizontalContentAlignment="Left"
                            Padding="8,6"
                            Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="panel" Margin="12,0,0,0">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="任务状态详情" Classes="heroTitle" IsVisible="{Binding ShowMainStateContent}" />
          <TextBlock Text="按旧版任务视图迁移：失败信息、进度、建议动作与冲突预览。" Opacity="0.75" TextWrapping="Wrap" IsVisible="{Binding ShowMainStateContent}" />

          <Border Classes="hintCard" IsVisible="{Binding IsEmptyState}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="📭" FontSize="56" HorizontalAlignment="Center" />
              <TextBlock Text="当前没有任务" Classes="hintTitle" HorizontalAlignment="Center" />
              <TextBlock Text="去下载页发起任务后，这里会实时展示任务进度、失败原因与重试建议。" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
            </StackPanel>
          </Border>

          <Border Classes="hintCard" IsVisible="{Binding IsFailedState}">
            <StackPanel Spacing="8">
              <TextBlock Text="失败原因" Classes="hintTitle" />
              <TextBlock Text="{Binding FailureSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <Border Classes="hintCard" IsVisible="{Binding IsRunningState}">
            <StackPanel Spacing="8">
              <TextBlock Text="当前状态" Classes="hintTitle" />
              <TextBlock Text="{Binding CurrentTaskStatus}" TextWrapping="Wrap" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="10" />
              <TextBlock Text="{Binding ProgressPercent, StringFormat=进度: {0:F1}%}" Opacity="0.75" />
            </StackPanel>
          </Border>

          <Border Classes="hintCard" IsVisible="{Binding IsCompletedState}">
            <StackPanel Spacing="8">
              <TextBlock Text="任务完成" Classes="hintTitle" />
              <TextBlock Text="当前任务已完成，可在历史任务中查看安装目录和报告。" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="hintCard" IsVisible="{Binding IsCancelledState}">
            <StackPanel Spacing="8">
              <TextBlock Text="任务已取消" Classes="hintTitle" />
              <TextBlock Text="任务被取消后可重新入队，或在下载页发起新的任务。" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="hintCard">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding AdviceTitle}" Classes="hintTitle" />
              <ItemsControl ItemsSource="{Binding SuggestedActions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="hintCard" IsVisible="{Binding HasConflictPreview}">
            <StackPanel Spacing="8">
              <TextBlock Text="安装冲突预览" Classes="hintTitle" />
              <ScrollViewer Height="150">
                <ItemsControl ItemsSource="{Binding ConflictPreviewItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
